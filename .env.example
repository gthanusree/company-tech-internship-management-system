# GEMINI_API_KEY: Optional if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email Configuration (Company Tech System)
# SUPPORT_EMAIL: Notification destination for new applicant submissions.
# Example: "support@companytech.example.com" or "hr@companytech.example.com"
SUPPORT_EMAIL="support@companytech.example.com"

# EMAIL_FROM: Transactional sender address displayed to candidates.
# When using Resend for testing without custom domain: "Company Tech <onboarding@resend.dev>"
# For production with verified domain: "Company Tech Admissions <internships@yourdomain.com>"
EMAIL_FROM="Company Tech <onboarding@resend.dev>"

# EMAIL_PROVIDER_API_KEY: Resend API key (re_...) or other transactional provider key.
# If omitted or left as placeholder, the system runs in high-fidelity simulated delivery mode,
# recording full delivery audit logs in Firestore and the admin panel without crashing.
EMAIL_PROVIDER_API_KEY="re_123456789_placeholder"

# ADMIN_EMAIL: Primary authorized administrator email for Company Tech.
ADMIN_EMAIL="gthanushree1566@gmail.com"
