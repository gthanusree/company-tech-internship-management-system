rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents unless explicitly granted
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Hardened Helper Functions
    // ------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Primary authorized administrator check
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'gthanushree1566@gmail.com';
    }

    // Secondary administrator registry check (for RBAC scalability)
    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidRole(role) {
      return role in [
        'Frontend Developer',
        'Backend Developer',
        'Full-Stack Developer',
        'AI/ML Engineer',
        'UI/UX Designer',
        'Graphic Designer',
        'Digital Marketing Intern',
        'Social Media Manager',
        'Content Writer',
        'Business Development Intern',
        'Community Manager',
        'HR Intern'
      ];
    }

    function isValidDuration(duration) {
      return duration in ['1 month', '2 months', '3 months'];
    }

    // Strict schema & boundary validation for application intake
    function isValidApplicationCreate(data) {
      return data.keys().hasAll(['applicationId', 'fullName', 'email', 'college', 'yearOfStudy', 'experienceLevel', 'role', 'status'])
        && data.applicationId is string && data.applicationId.size() > 0 && data.applicationId.size() <= 64
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email.size() > 3 && data.email.size() <= 120
        && data.college is string && data.college.size() > 0 && data.college.size() <= 150
        && data.yearOfStudy is string && data.yearOfStudy.size() <= 50
        && data.experienceLevel is string && (data.experienceLevel == 'Fresher' || data.experienceLevel == 'Experienced')
        && isValidRole(data.role)
        && data.status == 'Pending';
    }

    // Immutability checks: core candidate identity cannot be modified during status updates
    function isValidApplicationUpdate(data) {
      return data.status in ['Pending', 'Accepted', 'Rejected']
        && data.applicationId == existing().applicationId
        && data.email == existing().email
        && data.fullName == existing().fullName;
    }

    // Connection probe strictly limited to test collection document for health verification
    match /test/connection {
      allow read: if true;
    }

    // ------------------------------------------------------------------
    // Applications Collection Rules
    // ------------------------------------------------------------------
    match /applications/{appId} {
      // Single Document Retrieval:
      // Allowed only for authorized administrators OR authenticated applicants viewing their own document.
      allow get: if isValidId(appId) && (isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));

      // Collection Listing:
      // Strictly restricted to authorized administrators. Prevents candidate scraping and enumeration.
      allow list: if isAdmin();
      
      // Application Intake (Creation):
      // Public candidates can submit applications provided they satisfy all schema, field size, and role constraints.
      // Status MUST be 'Pending'.
      allow create: if isValidId(appId) 
        && isValidApplicationCreate(incoming()) 
        && incoming().applicationId == appId;
      
      // Application Decision Updates:
      // Strictly restricted to authorized administrators.
      // Enforces atomic state locking: only 'Pending' records can transition to 'Accepted' or 'Rejected'.
      allow update: if isValidId(appId) && isAdmin() && isValidApplicationUpdate(incoming()) && (
        // Action: Accept Application
        (
          existing().status == 'Pending' 
          && incoming().status == 'Accepted' 
          && isValidDuration(incoming().internshipDuration) 
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'decisionAt', 'internshipDuration', 'joiningDate', 
            'offerLetterId', 'emailStatus', 'updatedAt', 'adminNotes'
          ])
        )
        ||
        // Action: Reject Application
        (
          existing().status == 'Pending' 
          && incoming().status == 'Rejected' 
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'decisionAt', 'emailStatus', 'updatedAt', 'adminNotes'
          ])
        )
      );

      // Deletion is completely prohibited to ensure a permanent audit trail
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Admin Directory Collection (Strictly restricted to authorized admins)
    // ------------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
